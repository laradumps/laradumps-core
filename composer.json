{
    "name": "laradumps/laradumps-core",
    "version": "4.1.0",
    "description": "LaraDumps is a friendly app designed to boost your Laravel / PHP coding and debugging experience.",
    "homepage": "https://github.com/laradumps/laradumps-core",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Luan Freitas",
            "email": "luanfreitas10@protonmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ramsey/uuid": "^4.9.1",
        "symfony/var-dumper": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/process": "^6.4|^7.0|^8.0",
        "symfony/finder": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^6.4|^7.0|^8.0",
        "spatie/backtrace": "^1.5"
    },
    "require-dev": {
        "laravel/pint": "^1.26.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^1.10.50",
        "illuminate/support": "^12"
    },
    "suggest": {
        "nunomaduro/termwind": "For a better terminal experience"
    },
    "autoload": {
        "psr-4": {
            "LaraDumps\\LaraDumpsCore\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "LaraDumps\\LaraDumpsCore\\Tests\\" : "tests"
        }
    },
    "scripts": {
        "pint:fix": "./vendor/bin/pint",
        "test:pint": "./vendor/bin/pint --test",
        "test:types": "./vendor/bin/phpstan analyse --ansi --memory-limit=-1",
        "test:sqlite": "./vendor/bin/pest --order-by random",
        "verify": [
            "@test:pint",
            "@test:types",
            "@test:sqlite"
        ]
    },
    "bin": [
        "bin/laradumps"
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
